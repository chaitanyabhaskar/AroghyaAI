# GenAI Generated code - Start
# ArogyaAI configuration. Copy to .env and fill in LLM_API_KEY.

# ---- Model provider (any OpenAI-compatible /chat/completions endpoint) ----
# Groq:          https://api.groq.com/openai/v1
# Llama API:     https://api.llama.com/compat/v1
# OpenRouter:    https://openrouter.ai/api/v1
# OpenAI:        https://api.openai.com/v1
# Local Ollama:  http://localhost:11434/v1   (LLM_API_KEY=ollama)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

# Check your provider's current model list - IDs change. Must be vision-capable
# for the skin/wound photo feature.
LLM_TEXT_MODEL=qwen/qwen3.6-27b
LLM_VISION_MODEL=qwen/qwen3.6-27b

# Shown in the header next to the app name. Leave blank to show the model id.
MODEL_LABEL=

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=900
LLM_TIMEOUT=90

# ---- Storage ----
# Chat history. Point at a mounted volume in production, else it is ephemeral.
AROGYA_DB=data/arogya.db
HISTORY_TURNS=12

# ---- Nearby hospitals (OpenStreetMap Overpass - no API key needed) ----
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=40

# ---- Limits ----
MAX_MESSAGE_CHARS=4000
MAX_IMAGE_BYTES=4194304
RATE_LIMIT_PER_MIN=20

# Comma-separated origins, or * for any. Lock this down in production.
ALLOWED_ORIGINS=*

# ---- Access gate ----
# A single shared passcode. Leave EMPTY for local dev (open access).
# SET THIS before deploying to a public URL, otherwise anyone who finds the URL
# can spend your model quota. It is a shared secret, not a user login.
ACCESS_CODE=
# GenAI Generated code - End
